# ============================================================================
# geokube base image (heavy, slow-changing C/Fortran stack)
#
# Builds ESMF + esmpy + xesmf, which geokube needs for regridding. Rebuilt only
# when this file or the pinned ESMF/xesmf versions change. The geokube package
# itself is installed on top of this image by ./Dockerfile (production) and
# ./Dockerfile.dev (development).
#
# Multi-stage: the `builder` stage compiles ESMF and installs esmpy/xesmf into a
# virtualenv; the final `runtime` stage keeps only the venv and the compiled
# ESMF shared library, dropping the multi-GB ESMF source/object tree and the git
# checkout. A minimal toolchain is kept in the runtime so that pinned,
# wheel-less dependencies (e.g. numpy==2.0.2, which has no cp313 wheel) still
# build when geokube is installed on top. Bumping numpy to a release with cp313
# wheels (>=2.1) would let you drop the compilers for a much smaller image.
# ============================================================================

ARG UBUNTU_VERSION=25.10

# ----------------------------- builder stage --------------------------------
FROM ubuntu:${UBUNTU_VERSION} AS builder

# Version knobs (kept in sync between base and dev via build-args).
ARG ESMF_VERSION=8.9.1
ARG XESMF_VERSION=0.9.2
# 80.10.2 is the earliest setuptools whose VENDORED wheel is 0.46.3 (>= 0.46.2),
# clearing CVE-2026-24049 (path-traversal chmod in `wheel unpack`; affects vendored
# wheel 0.40.0–0.46.1). 80.9.0 vendored the vulnerable wheel 0.45.1. The flaw is
# build-time-only (not reachable at app runtime), so this is a SAST-hygiene bump.
ARG SETUPTOOLS_VERSION=80.10.2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential git gfortran \
      python3 python3-venv python3-dev \
      libudunits2-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Isolated virtualenv: avoids PEP 668 "externally-managed-environment"
# (no more --break-system-packages).
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "$VIRTUAL_ENV"
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# --- Build ESMF (shallow clone of the pinned tag, no full history) ---
ENV ESMF_DIR=/opt/esmf \
    ESMF_F90COMPILEOPTS=-fallow-argument-mismatch
RUN git clone --depth 1 --branch "v${ESMF_VERSION}" \
      https://github.com/esmf-org/esmf.git "$ESMF_DIR"
RUN make -C "$ESMF_DIR" -j"$(nproc)"

ENV ESMFMKFILE=/opt/esmf/lib/libO/Linux.gfortran.64.mpiuni.default/esmf.mk

# --- Build esmpy (from the ESMF tree) and xesmf into the venv ---
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir numpy "setuptools==${SETUPTOOLS_VERSION}"
RUN pip install --no-cache-dir "$ESMF_DIR/src/addon/esmpy"
RUN pip install --no-cache-dir \
      "git+https://github.com/pangeo-data/xesmf.git@v${XESMF_VERSION}"

# ----------------------------- runtime stage --------------------------------
FROM ubuntu:${UBUNTU_VERSION} AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Runtime deps:
#  - python3 / python3-dev: run the copied venv (same minor as builder) and
#    build pinned wheel-less deps (numpy==2.0.2 on Python 3.13)
#  - build-essential: C/C++ compiler for those source builds
#  - libudunits2-dev: headers + udunits2.xml data for cf-units (source build)
#  - libgfortran5: runtime dependency of the compiled libesmf.so
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-dev build-essential \
      libudunits2-dev libgfortran5 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Carry over the venv (esmpy + xesmf + numpy) and the compiled ESMF library.
# The ESMF lib dir MUST stay at the same path: esmf.mk encodes absolute paths
# that esmpy reads at import time to locate libesmf.so.
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/esmf/lib /opt/esmf/lib

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    UDUNITS2_XML_PATH=/usr/share/xml/udunits/udunits2.xml \
    ESMFMKFILE=/opt/esmf/lib/libO/Linux.gfortran.64.mpiuni.default/esmf.mk

WORKDIR /
